{
  "info": {
    "name": "Library Management System API - Week 2",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Complete CRUD endpoints for Genres and Books, JWT Authentication, and RBAC endpoints."
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jane Librarian\",\n  \"email\": \"jane.librarian@example.com\",\n  \"password\": \"Librarian123!\",\n  \"role\": \"LIBRARIAN\"\n}"
            }
          }
        },
        {
          "name": "Login User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ada.librarian@example.com\",\n  \"password\": \"Librarian123!\"\n}"
            }
          }
        },
        {
          "name": "Get Auth Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/auth/profile"
          }
        },
        {
          "name": "Get Users Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/users/profile"
          }
        }
      ]
    },
    {
      "name": "Genres",
      "item": [
        {
          "name": "Get All Genres",
          "request": { "method": "GET", "url": "{{baseUrl}}/genres" }
        },
        {
          "name": "Get Genre by ID",
          "request": { "method": "GET", "url": "{{baseUrl}}/genres/1" }
        },
        {
          "name": "Create Genre (LIBRARIAN)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/genres",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Biography\",\n  \"slug\": \"biography\"\n}"
            }
          }
        },
        {
          "name": "Update Genre (LIBRARIAN)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/genres/1",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sci-Fi & Cyberpunk\"\n}"
            }
          }
        },
        {
          "name": "Delete Genre (LIBRARIAN)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/genres/1"
          }
        }
      ]
    },
    {
      "name": "Books",
      "item": [
        {
          "name": "Get All Books (Filter, Search & Paginate)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/books?genreId=1&search=Dune&page=1&limit=10"
          }
        },
        {
          "name": "Get Book by ID",
          "request": { "method": "GET", "url": "{{baseUrl}}/books/1" }
        },
        {
          "name": "Create Book (LIBRARIAN)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/books",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Hyperion\",\n  \"author\": \"Dan Simmons\",\n  \"isbn\": \"9780553283686\",\n  \"totalCopies\": 4,\n  \"genreId\": 1\n}"
            }
          }
        },
        {
          "name": "Update Book (LIBRARIAN)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/books/1",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"totalCopies\": 6\n}"
            }
          }
        },
        {
          "name": "Delete Book (LIBRARIAN)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/books/1"
          }
        }
      ]
    }
  ]
}